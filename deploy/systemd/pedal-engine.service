[Unit]
Description=Pedal real-time audio engine
After=sound.target

[Service]
Type=simple
User=pedal
Group=audio
Environment=PEDAL_STATE_FILE=/var/lib/pedal/engine-state.json
Environment=PEDAL_TEST_AUDIO_FILE=/usr/share/pedal/test-audio/guitarjam-184.wav
RuntimeDirectory=pedal
RuntimeDirectoryMode=0755
ExecStart=/opt/pedal/bin/pedal-engine
Restart=on-failure
RestartSec=1
LimitRTPRIO=95
LimitMEMLOCK=infinity
Nice=-10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pedal /run/pedal

[Install]
WantedBy=multi-user.target
