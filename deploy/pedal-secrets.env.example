# Local credentials for the optional AI Tone Maker service.
#
# Copy this file to deploy/pedal-secrets.env, add your values there, and keep
# the copied file private. `pedal-secrets.env` is intentionally ignored by Git.
# On a production Pi, install the copied file as /etc/pedal/pedal-secrets.env
# with owner-only permissions (chmod 600).

# Secret: used only by the device-side AI Tone Maker service. Never place this
# value in Flutter/Dart code or ship it inside the touchscreen application.
PEDAL_OPENAI_API_KEY=
# Optional model override for the Responses API planner.
PEDAL_OPENAI_MODEL=gpt-5-mini

# Optional TypeSafe Jev key. When present, Jev ranks the small TONE3000
# candidate set with a confidence score; OpenAI remains the free-form planner
# and is used as the fallback ranker if Jev is offline or uncertain.
PEDAL_TYPESAFE_API_KEY=
PEDAL_TYPESAFE_MODEL=jev-latest

# Secret: Stable Audio API key for the optional Riff Vault backing-track
# generator. Create it at platform.stability.ai/account/keys and keep it only
# in this file or /etc/pedal/pedal-secrets.env, never in Flutter code.
PEDAL_STABILITY_API_KEY=

# TONE3000's publishable OAuth client key. The current catalog worker also
# needs a registered callback address to start the hosted Select flow.
PEDAL_TONE3000_PUBLISHABLE_KEY=
PEDAL_TONE3000_REDIRECT_URI=http://pedal.local:8787/callback

# Optional: retain OAuth tokens away from the source tree during development.
# PEDAL_TONE3000_TOKEN_FILE=/var/lib/pedal/tone3000-tokens.json
