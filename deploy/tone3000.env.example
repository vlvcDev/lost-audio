# Register this exact callback address for the TONE3000 publishable key.
PEDAL_TONE3000_PUBLISHABLE_KEY=t3k_pub_replace_me
PEDAL_TONE3000_REDIRECT_URI=http://pedal.local:8787/callback

# Optional overrides:
# PEDAL_TONE3000_TOKEN_FILE=/var/lib/pedal/tone3000-tokens.json
# PEDAL_TONE3000_BASE_URL=https://www.tone3000.com
